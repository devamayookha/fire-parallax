# ==========================================
# FIRE PARALLAX - GITIGNORE
# ==========================================

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Python environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.Python

# Environment variables and secrets
.env
.env.*
!.env.example
.streamlit/secrets.toml
.pypirc

# NASA FIRMS raw and processed datasets
data/raw/*
data/processed/*

# Preserve data directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/sample/.gitkeep

# Distribution and packaging
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache/
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
cover/

# Logs and temporary files
*.log
tempCodeRunnerFile.py
*.tmp
*.bak

# Database files
*.sqlite3
*.sqlite3-journal

# Jupyter Notebook
.ipynb_checkpoints

# IDE and editor settings
.vscode/
.idea/
.spyderproject
.spyproject
.ropeproject

# Type checking and linting
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Documentation builds
docs/_build/
site/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# PyInstaller
*.manifest
*.spec

# Other tools
.ipython/
.ipynb_checkpoints/
__pypackages__/
.pdm-python
.pdm-build/
.pixi/

# Generated interactive visualisations
assets/screenshots/*.html

# ==========================================
# END
